# Safe defaults. Copy to .env and fill secrets locally; never commit .env.
APP_ENVIRONMENT=development

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MOCK_LLM=1

# Twilio-only WhatsApp channel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=whatsapp:+00000000000
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VALIDATE_WEBHOOK=1
TWILIO_INBOUND_WEBHOOK_URL=https://your-domain.example/webhooks/twilio/whatsapp
TWILIO_WHATSAPP_ENABLED=0

# Internal admin console
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_DAYS=14

# Only WhatsApp is public in production
PUBLIC_WEB_CHAT_ENABLED=0
WHATSAPP_REPLY_LOCALE=en

AGENT_LEARN_ENABLED=1
AGENT_LEARN_USE_LLM=1
GUIDED_INTAKE_ENABLED=1
SESSION_RECORDING_ENABLED=0
